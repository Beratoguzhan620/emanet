# Copy to .env and change for anything beyond your own machine. Compose reads it; nothing here is committed.
POSTGRES_PASSWORD=emanet-local
JWT_SIGNING_KEY=local-signing-key-change-me-in-the-env-file-0123456789
STORAGE_ACCESS_KEY=emanet
STORAGE_SECRET_KEY=emanet-local-storage-key
# The account with this email settles damage claims and checks the books.
ADMIN_EMAIL=support@emanet.local
AUTH_ATTEMPTS_PER_MINUTE=10
